@@ -0,0 +1,72 @@
+#!/usr/bin/env python3
+import argparse
+import csv
+import hashlib
+import io
+import json
+from collections import defaultdict
+from decimal import Decimal, ROUND_HALF_UP
+from pathlib import Path
+
+
+def transform(input_path: Path, alpha: Decimal):
+    with input_path.open(newline="", encoding="utf-8") as handle:
+        rows = list(csv.DictReader(handle))
+
+    # 1. filter
+    filtered = [row for row in rows if Decimal(row["p_value"]) < alpha]
+    if not filtered:
+        raise ValueError("filter retained no rows")
+
+    # 2. normalize
+    maximum = max(Decimal(row["signal"]) for row in filtered)
+    normalized = [
+        (row["sample"], row["cohort"], Decimal(row["signal"]) / maximum)
+        for row in filtered
+    ]
+
+    # 3. aggregate
+    groups = defaultdict(list)
+    for _sample, cohort, value in normalized:
+        groups[cohort].append(value)
+
+    output = io.StringIO(newline="")
+    writer = csv.writer(output, lineterminator="\n")
+    writer.writerow(["cohort", "mean_normalized", "n"])
+    for cohort in sorted(groups):
+        values = groups[cohort]
+        mean = (sum(values) / Decimal(len(values))).quantize(
+            Decimal("0.000001"), rounding=ROUND_HALF_UP
+        )
+        writer.writerow([cohort, f"{mean:.6f}", len(values)])
+
+    return output.getvalue(), [row["sample"] for row in filtered]
+
+
+parser = argparse.ArgumentParser()
+parser.add_argument("--alpha", required=True, type=Decimal)
+parser.add_argument("--input", required=True, type=Path)
+mode = parser.add_mutually_exclusive_group(required=True)
+mode.add_argument("--output", type=Path)
+mode.add_argument("--verify", type=Path)
+args = parser.parse_args()
+
+rendered, retained = transform(args.input, args.alpha)
+digest = hashlib.sha256(rendered.encode("utf-8")).hexdigest()
+
+if args.output:
+    if args.output.exists():
+        raise SystemExit(f"refusing to overwrite {args.output}")
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(rendered, encoding="utf-8")
+else:
+    actual = args.verify.read_text(encoding="utf-8")
+    if actual != rendered:
+        raise SystemExit("verification failed: artifact differs from recomputation")
+
+print(json.dumps({
+    "alpha": str(args.alpha),
+    "order": ["filter", "normalize", "aggregate"],
+    "retained_samples": retained,
+    "output_sha256": digest,
+}, sort_keys=True))
